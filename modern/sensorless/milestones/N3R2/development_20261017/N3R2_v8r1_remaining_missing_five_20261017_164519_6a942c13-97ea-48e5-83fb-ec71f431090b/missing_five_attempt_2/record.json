    "exact_callback": "% Embedded verbatim in the model InitFcn; no helper file is needed to run SLX.\nteach_model = bdroot;\nteach_workspace = get_param(teach_model,'ModelWorkspace');\nteach_cfg_path = [teach_model '/时序设置'];\nteach_divider = str2double(get_param(teach_cfg_path,'speed_divider'));\nteach_cycles = str2double(get_param(teach_cfg_path,'pwm_cycles'));\nvalidateattributes(teach_divider,{'double'},{'scalar','real','finite','integer','>=',1,'<=',1000});\nvalidateattributes(teach_cycles,{'double'},{'scalar','real','finite','integer','>=',1,'<=',20});\nteach_dt = getVariable(teach_workspace,'dt');\nteach_period = getVariable(teach_workspace,'Ts_speed');\nif strcmp(get_param(teach_cfg_path,'speed_on'),'on')\n    teach_period = teach_dt*teach_divider;\nend\nassert(teach_period >= teach_dt && abs(teach_period/teach_dt-round(teach_period/teach_dt))<1e-9, ...\n    '速度环周期必须为电流控制周期的正整数倍。');\nteach_names = {'teaching_Ts_speed','teach_pwm_on','teach_pwm_cycles'};\nteach_values_to_set = {teach_period,double(strcmp(get_param(teach_cfg_path,'pwm_on'),'on')),teach_cycles};\nfor teach_index = 1:numel(teach_names)\n    if ~isequaln(getVariable(teach_workspace,teach_names{teach_index}),teach_values_to_set{teach_index})\n        assignin(teach_workspace,teach_names{teach_index},teach_values_to_set{teach_index});\n    end\nend\n\n\nassignin(get_param(bdroot,'ModelWorkspace'),'decoupling_enabled',double(strcmp(get_param([bdroot '/解耦'],'enabled'),'on')));\n% Embedded in InitFcn after the pre-existing teaching initialization.\ntim_m=bdroot;tim_ws=get_param(tim_m,'ModelWorkspace');tim_path=[tim_m '/时序设置'];\ntim_on=double(strcmp(get_param(tim_path,'real_on'),'on'));\ntim_period=getVariable(tim_ws,'dt');tim_speed=getVariable(tim_ws,'teaching_Ts_speed');\ntim_trigger=str2double(get_param(tim_path,'trigger_us'))*1e-6;\ntim_sync=str2double(get_param(tim_path,'sync_us'))*1e-6;\ntim_compute=str2double(get_param(tim_path,'compute_us'))*1e-6;\ntim_guard=str2double(get_param(tim_path,'settle_us'))*1e-6;\ntim_window=double(strcmp(get_param(tim_path,'window_on'),'on'));\ntim_hold=double(strcmp(get_param(tim_path,'invalid_hold_on'),'on'));\ntim_mode=double(strcmp(get_param(tim_path,'update_mode'),'仅谷底（对照）'));\ntim_h=1e-6;tim_control=tim_period;tim_speed_sample=tim_speed;\ntim_static=-1;\ntim_carrier=[0 tim_period/2 0];\nvalidateattributes([tim_trigger tim_sync tim_compute tim_guard],{'double'},{'real','finite','nonnegative'});\nif tim_on\n assert(strcmp(get_param(tim_path,'pwm_on'),'off'),'真实时序与旧整周期输出延迟不可同时启用。');\n assert(strcmp(get_param([tim_m '/采样设置'],'delay_on'),'off'),'真实时序与旧整周期采样延迟不可同时启用。');\n tim_h=62.5e-9;\n tim_grid_divider=str2double(get_param(tim_path,'grid_divider'));\n validateattributes(tim_grid_divider,{'double'},{'scalar','integer','>=',1,'<=',2});\n % Optional finer grid for convergence checks, still configured explicitly.\n tim_h=tim_h/tim_grid_divider;\n validateattributes(tim_h,{'double'},{'scalar','finite','positive'});\n tim_jeos=tim_trigger+tim_sync+4.5e-6;\n assert(tim_compute>=tim_h,'计算耗时至少为一个事件网格，避免写入读取同拍未完成指令。');\n assert(tim_jeos+tim_compute<tim_period,'本版要求整组转换及计算在同一PWM周期内完成。');\n assert(tim_jeos>0 && tim_jeos<tim_period);\n timing_grid_values=[tim_trigger tim_sync tim_compute tim_guard 1.1875e-6 1.5e-6 tim_period tim_speed];\n assert(all(abs(timing_grid_values/tim_h-round(timing_grid_values/tim_h))<1e-7),'事件时间必须落在62.5ns（或更细）网格上。');\n tim_control=[tim_period tim_jeos];\n tim_static=0;\n tim_speed_sample=[tim_speed tim_jeos+tim_speed-tim_period];\n % Existing comparator is carrier>=threshold; inverted carrier implements PWM1.\n tim_carrier=[tim_period/2 0 tim_period/2];\nelse\n assert(~tim_window && ~tim_hold,'有效窗口及无效值保持需要先开启真实时序。');\nend\nassert(~tim_hold || tim_window,'无效值保持需要同时开启低侧采样窗口。');\ntim_adc_cfg=[tim_on tim_window tim_hold tim_h tim_period tim_trigger 1.1875e-6 1.5e-6 tim_sync tim_guard tim_speed/tim_period];\ntim_pwm_cfg=[tim_on tim_h tim_period tim_trigger 1.1875e-6 1.5e-6 tim_sync tim_compute tim_mode 4000];\ntim_names={'timing_on','timing_h','timing_control_sample','timing_speed_sample','timing_carrier_y','timing_adc_cfg','timing_pwm_cfg','timing_static_math'};\ntim_vals={tim_on,tim_h,tim_control,tim_speed_sample,tim_carrier,tim_adc_cfg,tim_pwm_cfg,tim_static};\nfor tim_k=1:numel(tim_names),assignin(tim_ws,tim_names{tim_k},tim_vals{tim_k});end\nset_param(tim_m,'FixedStep','timing_h');\n\n% Append after existing timing InitFcn. Defaults preserve the timing baseline.\ndead_m=bdroot;dead_ws=get_param(dead_m,'ModelWorkspace');dead_path=[dead_m '/功率设置'];\ndead_gate=double(strcmp(get_param(dead_path,'gate_on'),'on'));\ndead_comp=double(strcmp(get_param(dead_path,'comp_on'),'on'));\ndead_dt=str2double(get_param(dead_path,'gate_us'))*1e-6;\ndead_ct=str2double(get_param(dead_path,'comp_us'))*1e-6;\ndead_band=str2double(get_param(dead_path,'hysteresis_A'));\ndead_zero=str2double(get_param(dead_path,'zero_A'));\nvalidateattributes([dead_dt dead_ct dead_band dead_zero],{'double'},{'real','finite','nonnegative'});\nassert(~dead_comp||dead_gate,'先启用门极死区，再启用补偿，避免给理想桥额外施加电压误差。');\nassert(~dead_gate||strcmp(get_param(dead_path,'dead_on'),'off'),'真实门极死区与旧平均死区压降互斥，避免重复计算。');\ndead_step=getVariable(dead_ws,'timing_h');\nif dead_gate\n assert(abs(getVariable(dead_ws,'Ld')-getVariable(dead_ws,'Lq'))<1e-12,'本轮近零续流模型适用于当前Ld=Lq的PMSM。');\n dead_step=min(dead_step,62.5e-9);\n assert(dead_dt<getVariable(dead_ws,'Ts')/4,'死区应小于PWM周期的四分之一。');\n assert(abs(dead_dt/dead_step-round(dead_dt/dead_step))<1e-7,'门极死区必须落在事件网格上。');\n assignin(dead_ws,'timing_h',dead_step);\nend\ndead_drop=double(strcmp(get_param(dead_path,'drop_on'),'on'));\nassignin(dead_ws,'dead_gate_on',dead_gate);assignin(dead_ws,'dead_h',dead_step);\nassignin(dead_ws,'dead_gate_cfg',[dead_gate dead_step dead_dt]);\nassignin(dead_ws,'dead_comp_cfg',[dead_comp dead_ct getVariable(dead_ws,'Ts') dead_band]);\nassignin(dead_ws,'dead_bridge_cfg',[getVariable(dead_ws,'p') getVariable(dead_ws,'phis') dead_zero dead_drop ...\n str2double(get_param(dea